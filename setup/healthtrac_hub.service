[Unit]
Description=HealthTRAC Hub Service
After=multi-user.target

[Service]
Type=idle

User=healthtrac
WorkingDirectory=/home/healthtrac/healthTRAC/
ExecStart=/home/healthtrac/healthTRAC/.venv/bin/python3 /home/healthtrac/healthTRAC/hub.py

Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target