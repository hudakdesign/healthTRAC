[Unit]
Description=HealthTRAC Satellite Service
After=multi-user.target

[Service]
Type=idle

User=healthtrac
WorkingDirectory=/home/healthtrac/healthTRAC/
ExecStart=/home/healthtrac/.local/bin/uv run /home/healthtrac/healthTRAC/satellite.py

Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target