{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "subsystemType": {
            "type": "string"
        },
        "lastConnectTimeMs": {
            "type": "integer",
            "exclusiveMinimum": 0
        },
        "signalStrengthDbm": {
            "type": "integer"
        },
        "timeSent": {
            "type": "integer",
            "exclusiveMinimum": 0
        },
        "dataPolls": {
            "type": "object",
            "properties": {
                "timestamps": {
                    "type": "array",
                    "items": {
                        "type": "integer",
                        "exclusiveMinimum": 0
                    }
                },
                "accelX": {
                    "description": "Raw values for the acceleration, requires conversion to make sense",
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "accelY": {
                    "description": "Raw values for the acceleration, requires conversion to make sense",
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "accelZ": {
                    "description": "Raw values for the acceleration, requires conversion to make sense",
                    "type": "array",
                    "items": {
                        "type": "integer"
                    }
                },
                "batteryAdc": {
                    "type": "array",
                    "items": {
                        "type": "integer",
                        "minimum": 0
                    }
                }
            },
            "required": [
                "timestamps",
                "accelX",
                "accelY",
                "accelZ",
                "batteryAdc"
            ]
        }
    },
    "required": [
        "subsystemType",
        "lastConnectTimeMs",
        "signalStrengthDbm",
        "timeSent",
        "dataPolls"
    ]
}